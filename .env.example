# =============================================================================
# Frontend (Vite) build-time vars — must start with VITE_, exposed to bundle.
# =============================================================================

# Firebase Identity Toolkit API key — used for store-manager sign-in and token
# refresh. Each Firebase project has its own key. Use the project that matches
# your BE environment (prod Firebase ↔ prod gateway).
VITE_FIREBASE_API_KEY=

# Frontend base URL for BE calls.
# Leave EMPTY in normal cases — the FE will hit /api/* on the same origin and
# the Vercel Edge Function (api/[...path].ts) proxies to BE_BASE_URL.
# Only set this if you want to bypass the proxy and call a gateway directly
# (e.g. local development against a custom backend with CORS enabled).
VITE_API_BASE_URL=

# OpenAI API key used by the legacy-CSV normalization workspace's AI repair
# pass AND the AI-personalised recovery SMS copy. PROTOTYPE-ONLY: this is
# exposed to the browser. Before any non-prototype use, move the calls
# server-side (Vercel function under api/), mirroring api/proxy.ts, so the key
# never ships to clients. Required only for the AI buttons on the /import
# workspace; everything else works without it.
VITE_OPENAI_API_KEY=

# Recovery-SMS sending mode (customer profiling outreach).
# When unset or any value other than "false", sends are a DRY RUN: simulated in
# the browser and logged to the console — no provider, no server call. This is
# the default so the flow is fully testable under `vite dev` (where /api/* is
# proxied to the BE gateway and api/send-sms would not run locally).
# Set to "false" to actually POST to /api/send-sms (needs SMS_PROVIDER below).
VITE_SMS_DRYRUN=

# Recovery-link storage backend:
#   unset/"local" → links live in the manager's browser IndexedDB (same-device).
#   "http"        → durable cross-device store via the recovery-api microservice
#                   (Express+Mongo) — the mode for real SMS campaigns. Requires
#                   VITE_RECOVERY_API_URL below.
#   "firestore"   → dormant alternative, superseded by "http".
VITE_RECOVERY_BACKEND=

# Base URL of the deployed recovery-api microservice (no trailing slash), e.g.
# https://monnalisa-recovery-api.vercel.app. Required when VITE_RECOVERY_BACKEND=http.
# The manager's browser calls /links/* (authed); the customer's phone calls
# /recover/* (public) — so the service's CORS_ORIGINS must include the app origin.
VITE_RECOVERY_API_URL=

# Firebase project id — only for the dormant "firestore" backend.
VITE_FIREBASE_PROJECT_ID=

# =============================================================================
# Vercel Edge Function server-side var — NO VITE_ prefix, NOT in the bundle.
# =============================================================================

# Backend API gateway URL the proxy forwards to. Configure this PER Vercel
# project so prod and staging hit different gateways:
#   Production project  → BE_BASE_URL=https://<prod-gateway>            (TBD — awaiting BE)
#   Staging project     → BE_BASE_URL=https://monnalisa-mid-dev-api-gw-1lcvs0vu.ew.gateway.dev
# Local dev does NOT need this — the Vite proxy in vite.config.ts handles /api.
BE_BASE_URL=

# SMS provider selector for api/send-sms.ts (only used when VITE_SMS_DRYRUN=false).
# Default "dryrun" simulates server-side too. Real adapters are stubbed in
# api/send-sms.ts and need their own secrets when implemented:
#   skebby  → SKEBBY_USER / SKEBBY_KEY   (Italian SMS provider)
#   twilio  → TWILIO_SID / TWILIO_TOKEN / TWILIO_FROM
#   smsapi  → SMSAPI_TOKEN / SMSAPI_FROM (smsapi.com — EU SMS provider)
#   gateway → forwards to the BE gateway's SMS endpoint (BE owns the provider)
SMS_PROVIDER=

# Twilio credentials (server-only, used by api/send-sms.ts when SMS_PROVIDER=twilio).
# TWILIO_FROM is an SMS-capable number in E.164 (e.g. a US number +1XXXXXXXXXX)
# or a Messaging Service SID (MGxxxxxxxx…). For a US test, use your Twilio US number.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# SMSAPI.com credentials (server-only, used by api/send-sms.ts when SMS_PROVIDER=smsapi).
#   SMSAPI_TOKEN    — OAuth2 access token (smsapi.com → API → OAuth/Tokens). Required.
#   SMSAPI_FROM     — verified sender name. Leave empty to use the account default
#                     ("Test" eco sender on trial accounts).
#   SMSAPI_BASE_URL — optional host override (default https://api.smsapi.com; use
#                     https://api.smsapi.pl for the Polish region).
#   SMSAPI_TEST     — set to "1" to validate the request without sending/charging.
SMSAPI_TOKEN=
SMSAPI_FROM=
SMSAPI_BASE_URL=
SMSAPI_TEST=

# Recovery backend — server-only credentials for api/recover/[token].ts (the
# PUBLIC customer endpoint, which uses a service account). Absent → the function
# fails closed with 501. See docs/recovery-backend.md.
#   FIREBASE_PROJECT_ID        — the Firestore project id (no VITE_ prefix)
#   GOOGLE_SERVICE_ACCOUNT_JSON — service-account key JSON (datastore.user role)
FIREBASE_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
